########################################
# Server
########################################

SERVER_PORT=8080

########################################
# PostgreSQL
########################################

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=ticket_booking

POSTGRES_USERNAME=your_user
POSTGRES_PASSWORD=your_password

########################################
# Redis
########################################

REDIS_HOST=localhost
REDIS_PORT=6379

########################################
# Jackson
########################################

JACKSON_TIME_ZONE=Asia/Ho_Chi_Minh

########################################
# Logging
########################################

LOG_LEVEL_ROOT=INFO

########################################
# JWT
########################################

JWT_SECRET=change-me-to-a-256-bit-base64-encoded-secret
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

########################################
# Google OAuth2
########################################

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH2_REDIRECT_URI=http://localhost:5173/oauth2/success
OAUTH2_FAILURE_URI=http://localhost:5173/login?error=oauth2

########################################
# Mail (Gmail)
########################################

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@ticketbooking.com

########################################
# RabbitMQ
########################################

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

########################################
# Security / CORS
########################################

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000